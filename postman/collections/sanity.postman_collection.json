    {
      "name": "Bible shared reference integrity",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v2/pub-nwtsty/?urls={{bibleUrl}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 and JSON', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "const body = pm.response.json();",
              "pm.test('No reference extraction placeholders', function () {",
              "    pm.expect(JSON.stringify(body)).not.to.include('UNEXPECTED_ERROR_UNABLE_TO_EXTRACT_REFERENCE');",
              "});",
              "",
              "pm.test('Every citation resolves to a shared reference', function () {",
              "    pm.expect(body).to.have.lengthOf(1);",
              "    pm.expect(body[0].link).to.equal(pm.variables.get('bibleUrl'));",
              "    pm.expect(body[0].entries).to.be.an('array').that.is.not.empty;",
              "    body[0].entries.forEach(entry => {",
              "        pm.expect(entry.citations).to.be.an('array').that.is.not.empty;",
              "        pm.expect(entry.citationTokenCount).to.be.above(0);",
              "        entry.citations.forEach(citation => {",
              "            pm.expect(body[0].sharedReferences).to.have.property(citation.referenceId);",
              "            pm.expect(body[0].sharedReferences[citation.referenceId].contents).to.be.a('string').that.is.not.empty;",
              "        });",
              "    });",
              "    pm.collectionVariables.set('observedBible', JSON.stringify(body[0]));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Bible grouping preserves entries and handles oversized entries",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v2/pub-nwtsty/grouped?urls={{bibleUrl}}&tokenLimit=1000"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 and JSON', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "const body = pm.response.json();",
              "pm.test('No reference extraction placeholders', function () {",
              "    pm.expect(JSON.stringify(body)).not.to.include('UNEXPECTED_ERROR_UNABLE_TO_EXTRACT_REFERENCE');",
              "});",
              "",
              "pm.test('Grouping loses no data and honors the token boundary', function () {",
              "    const original = JSON.parse(pm.collectionVariables.get('observedBible'));",
              "    pm.expect(body).to.have.lengthOf(1);",
              "    pm.expect(body[0].link).to.equal(original.link);",
              "    pm.expect(body[0].sharedReferences).to.eql(original.sharedReferences);",
              "    pm.expect(body[0].clusters).to.be.an('array').that.is.not.empty;",
              "    pm.expect(body[0].clusters.flat()).to.eql(original.entries);",
              "    body[0].clusters.forEach(cluster => {",
              "        pm.expect(cluster).to.be.an('array').that.is.not.empty;",
              "        const total = cluster.reduce((sum, entry) => sum + entry.citationTokenCount, 0);",
              "        if (total > 1000) pm.expect(cluster).to.have.lengthOf(1);",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
