{
  "info": {
    "name": "v2 risk-based sanity",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "Object.entries(pm.iterationData.get('sources')).forEach(([key, value]) => pm.variables.set(key, value));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Watchtower curated article associations",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v2/pub-w/?url={{watchtowerUrl}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 and JSON', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "const body = pm.response.json();",
              "pm.test('No reference extraction placeholders', function () {",
              "    pm.expect(JSON.stringify(body)).not.to.include('UNEXPECTED_ERROR_UNABLE_TO_EXTRACT_REFERENCE');",
              "});",
              "",
              "pm.test('Article flow and index relations are consistent', function () {",
              "    const content = body.content;",
              "    pm.expect(body.articleTitle).to.be.a('string').that.is.not.empty;",
              "    pm.expect(content).to.be.an('array').that.is.not.empty;",
              "    function target(index, kind) {",
              "        pm.expect(Number.isInteger(index)).to.equal(true);",
              "        pm.expect(index).to.be.within(0, content.length - 1);",
              "        pm.expect(content[index].kind).to.equal(kind);",
              "    }",
              "    target(body.indexReferences.teachBlockIndex, 'teachBlock');",
              "    pm.expect(body.indexReferences.questions).to.be.an('array').that.is.not.empty;",
              "    body.indexReferences.questions.forEach(question => {",
              "        target(question.questionIndex, 'question');",
              "        if (question.sectionHeadingIndex !== undefined) target(question.sectionHeadingIndex, 'sectionHeading');",
              "        const kinds = { relevantParagraphIndexes: 'paragraph', relevantIllustrationIndexes: 'illustration', relevantBoxSupplementIndexes: 'boxSupplement', relevantFootnoteIndexes: 'footnote', relevantVideoIndexes: 'video' };",
              "        Object.entries(kinds).forEach(([key, kind]) => (question[key] || []).forEach(index => target(index, kind)));",
              "    });",
              "    ['footnotes', 'boxSupplements'].forEach(key => (body.indexReferences[key] || []).forEach(ref => {",
              "        pm.expect(Number.isInteger(ref.sourceIndex)).to.equal(true);",
              "        pm.expect(ref.sourceIndex).to.be.within(0, content.length - 1);",
              "        target(ref.targetIndex, key === 'footnotes' ? 'footnote' : 'boxSupplement');",
              "        const targetItem = content[ref.targetIndex];",
              "        if (key === 'footnotes') {",
              "            pm.expect(targetItem.payload.marker).to.equal(ref.marker);",
              "        } else {",
              "            pm.expect(targetItem.payload.title).to.equal(ref.title);",
              "            pm.expect(content[ref.sourceIndex].payload.text).to.include(ref.title);",
              "        }",
              "    }));",
              "});",
              "",
              "pm.test('Citation markers resolve within their text block', function () {",
              "    let blocks = 0;",
              "    function visit(value) {",
              "        if (!value || typeof value !== 'object') return;",
              "        if (typeof value.textWithCitations === 'string') {",
              "            blocks++;",
              "            const citations = value.citations || [];",
              "            citations.forEach(citation => {",
              "                pm.expect(Number.isInteger(citation.id) && citation.id > 0).to.equal(true);",
              "                const expectedMarker = '[[cite:' + citation.id + ']]';",
              "                if (citation.marker !== undefined) pm.expect(citation.marker).to.equal(expectedMarker);",
              "                pm.expect(value.textWithCitations).to.include(expectedMarker);",
              "            });",
              "            const ids = citations.map(citation => citation.id);",
              "            pm.expect(new Set(ids).size).to.equal(ids.length);",
              "            for (const match of value.textWithCitations.matchAll(/\\[\\[cite:(\\d+)\\]\\]/g)) {",
              "                pm.expect(ids).to.include(Number(match[1]));",
              "            }",
              "            citations.forEach(citation => {",
              "                pm.expect(citation.contents).to.be.a('string').that.is.not.empty;",
              "                pm.expect(citation.referenceType).to.be.a('string').that.is.not.empty;",
              "            });",
              "        }",
              "        Object.values(value).forEach(visit);",
              "    }",
              "    visit(body);",
              "    pm.expect(blocks).to.be.above(0);",
              "});",
              "pm.test('Curated article retains its title and challenging content kinds', function () {",
              "    const expected = pm.iterationData.get('expected');",
              "    pm.expect(body.articleTitle).to.equal(expected.watchtowerTitle);",
              "    const kinds = body.content.map(item => item.kind);",
              "    expected.watchtowerRequiredKinds.forEach(kind => pm.expect(kinds).to.include(kind));",
              "    const footnote = body.indexReferences.footnotes.find(ref => ref.marker === 'a');",
              "    pm.expect(footnote).to.exist;",
              "    pm.expect(body.content[footnote.sourceIndex].payload.number).to.equal(expected.watchtowerFootnoteSourceNumber);",
              "});"
            ]
          }
        }
      ]
    },
