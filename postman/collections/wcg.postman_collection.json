{
  "info": {
    "_postman_id": "d2d1a198-e465-4f08-bfd4-fac2ea8521f0",
    "name": "WCG Positive E2E",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Positive regression checks for GET /v2/pub-wcg using iteration data baselines."
  },
  "item": [
    {
      "name": "WCG Positive Batch",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function readIterationValue(key) {",
              "  const value = pm.iterationData.get(key);",
              "",
              "  if (typeof value !== 'string') {",
              "    return value;",
              "  }",
              "",
              "  const trimmed = value.trim();",
              "  if (!trimmed) {",
              "    return value;",
              "  }",
              "",
              "  if (trimmed.startsWith('{') || trimmed.startsWith('[')) {",
              "    return JSON.parse(trimmed);",
              "  }",
              "",
              "  return value;",
              "}",
              "",
              "const urls = readIterationValue('urls');",
              "",
              "pm.test('Iteration data includes urls array', function () {",
              "  pm.expect(urls, 'urls').to.be.an('array').that.is.not.empty;",
              "});",
              "",
              "const query = urls.map(function (url) {",
              "  return 'urls=' + encodeURIComponent(url);",
              "}).join('&');",
              "",
              "const requestUrl = pm.variables.replaceIn('{{baseUrl}}/{{v2BasePath}}/{{wcgPath}}') + '?' + query;",
              "pm.variables.set('requestUrl', requestUrl);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function readIterationValue(key) {",
              "  const value = pm.iterationData.get(key);",
              "",
              "  if (typeof value !== 'string') {",
              "    return value;",
              "  }",
              "",
              "  const trimmed = value.trim();",
              "  if (!trimmed) {",
              "    return value;",
              "  }",
              "",
              "  if (trimmed.startsWith('{') || trimmed.startsWith('[')) {",
              "    return JSON.parse(trimmed);",
              "  }",
              "",
              "  return value;",
              "}",
              "",
              "function assertDeepSubset(actual, expected, path) {",
              "  if (Array.isArray(expected)) {",
              "    pm.expect(actual, path + ' should be an array').to.be.an('array');",
              "    pm.expect(actual.length, path + ' length').to.eql(expected.length);",
              "",
              "    expected.forEach(function (expectedItem, index) {",
              "      assertDeepSubset(actual[index], expectedItem, path + '[' + index + ']');",
              "    });",
              "",
              "    return;",
              "  }",
              "",
              "  if (expected && typeof expected === 'object') {",
              "    pm.expect(actual, path + ' should be an object').to.be.an('object');",
              "",
              "    Object.keys(expected).forEach(function (key) {",
              "      pm.expect(actual, path + '.' + key + ' should exist').to.have.property(key);",
              "      assertDeepSubset(actual[key], expected[key], path + '.' + key);",
              "    });",
              "",
              "    return;",
              "  }",
              "",
              "  pm.expect(actual, path).to.eql(expected);",
              "}",
              "",
              "function projectQuestionBlock(block) {",
              "  return {",
              "    text: block.text,",
              "    figure: block.figure ? Object.assign(",
              "      { alt: block.figure.alt },",
              "      block.figure.caption ? { caption: block.figure.caption } : {}",
              "    ) : null,",
              "    citationMnemonics: block.citations.map(function (citation) { return citation.mnemonic; })",
              "  };",
              "}",
              "",
              "function projectLessonContents(contents) {",
              "  return {",
              "    number: contents.number,",
              "    subject: contents.subject,",
              "    title: contents.title,",
              "    narration: contents.narration,",
              "    narrationFigures: contents.narrationFigures.map(function (figure) { return figure.alt; }),",
              "    featuredQuote: contents.featuredQuote,",
              "    readTheBibleAccount: contents.readTheBibleAccount.map(function (entry) { return entry.mnemonic; }),",
              "    forDiscussion: contents.forDiscussion,",
              "    digDeeper: contents.digDeeper.map(function (block) { return projectQuestionBlock(block); }),",
              "    reflectOnTheLessons: contents.reflectOnTheLessons.map(function (block) {",
              "      return Object.assign(",
              "        projectQuestionBlock(block),",
              "        block.subPoints && block.subPoints.length > 0",
              "          ? { subPoints: block.subPoints.map(function (subPoint) { return projectQuestionBlock(subPoint); }) }",
              "          : { subPoints: [] }",
              "      );",
              "    }),",
              "    meditateOnTheBiggerPicture: contents.meditateOnTheBiggerPicture",
              "  };",
              "}",
              "",
              "function projectItemForComparison(item) {",
              "  if (item.type === 'LESSON') {",
              "    return projectLessonContents(item.contents);",
              "  }",
              "",
              "  if (item.type === 'GB_LETTER') {",
              "    return {",
              "      title: item.contents.title,",
              "      closing: item.contents.closing,",
              "      figures: item.contents.figures.map(function (figure) {",
              "        return Object.assign(",
              "          { alt: figure.alt },",
              "          figure.caption ? { caption: figure.caption } : {}",
              "        );",
              "      })",
              "    };",
              "  }",
              "",
              "  return item.contents;",
              "}",
              "",
              "pm.test('Response status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const responseJson = pm.response.json();",
              "const expectedOrder = readIterationValue('expectedOrder');",
              "const expectedItems = readIterationValue('expectedItems');",
              "",
              "pm.test('Response is an array', function () {",
              "  pm.expect(responseJson).to.be.an('array');",
              "});",
              "",
              "pm.test('Returned links match expected order', function () {",
              "  const returnedOrder = responseJson.map(function (item) {",
              "    return item.link;",
              "  });",
              "",
              "  pm.expect(returnedOrder).to.eql(expectedOrder);",
              "});",
              "",
              "const itemsByLink = responseJson.reduce(function (acc, item) {",
              "  acc[item.link] = item;",
              "  return acc;",
              "}, {});",
              "",
              "pm.test('All expected items are present', function () {",
              "  const returnedLinks = Object.keys(itemsByLink).sort();",
              "  const expectedLinks = expectedItems.map(function (item) {",
              "    return item.link;",
              "  }).sort();",
              "",
              "  pm.expect(returnedLinks).to.eql(expectedLinks);",
              "});",
              "",
              "expectedItems.forEach(function (expectedItem) {",
              "  pm.test('Type matches for ' + expectedItem.link, function () {",
              "    const actualItem = itemsByLink[expectedItem.link];",
              "    pm.expect(actualItem, 'Missing item for ' + expectedItem.link).to.exist;",
              "    pm.expect(actualItem.type).to.eql(expectedItem.type);",
              "  });",
              "",
              "  pm.test('Expected fragment matches for ' + expectedItem.link, function () {",
              "    const actualItem = itemsByLink[expectedItem.link];",
              "    pm.expect(actualItem, 'Missing item for ' + expectedItem.link).to.exist;",
              "    const projected = projectItemForComparison(actualItem);",
              "    assertDeepSubset(projected, expectedItem.expected, expectedItem.link + '.contents');",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{requestUrl}}",
        "description": "Runs one positive WCG batch scenario from the iteration data file."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "v2BasePath",
      "value": "v2"
    },
    {
      "key": "wcgPath",
      "value": "pub-wcg"
    }
  ]
}
