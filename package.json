{
  "name": "wol-sieve",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "./run.sh start",
    "start:debug": "./run.sh debug",
    "start:inspect": "./run.sh inspect",
    "build": "tsc",
    "serve": "./run.sh serve",
    "format": "prettier . --write",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docker:image": "node -p \"'dkr-reg.home.leaflex.site/' + process.env.npm_package_name + ':latest'\"",
    "docker:build": "docker build -t $(npm run -s docker:image) .",
    "docker:push": "docker push $(npm run -s docker:image)",
    "docker:buildnpush": "npm run docker:build && npm run docker:push",
    "docker:run": "docker run --rm -p 3389:3389 $(npm run -s docker:image)",
    "docker:buildnpush:run": "npm run docker:buildnpush && npm run docker:run"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.5.5",
    "nodemon": "3.1.7",
    "prettier": "3.3.3",
    "typescript": "5.6.2",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "express": "4.21.2",
    "markify-ts": "0.0.18",
    "pino": "9.4.0",
    "pino-http": "10.3.0",
    "tiktoken": "1.0.21"
  }
}
