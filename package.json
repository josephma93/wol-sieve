{
  "name": "wol-sieve",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "./run.sh start",
    "start:debug": "./run.sh debug",
    "start:inspect": "./run.sh inspect",
    "build": "tsc",
    "serve": "./run.sh serve",
    "format": "prettier . --write",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docker:build": "docker build -t dkr-reg.home.leaflex.site/$(node -p \"require('./package.json').name\"):latest .",
    "docker:push": "docker push dkr-reg.home.leaflex.site/$(node -p \"require('./package.json').name\"):latest",
    "docker:buildnpush": "npm run docker:build && npm run docker:push"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.5",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.0",
    "markify-ts": "^0.0.18",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "tiktoken": "^1.0.21"
  }
}
